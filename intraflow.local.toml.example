# Copy this file to intraflow.local.toml and use UUIDv4 values provisioned by an administrator.
current_user_id = "00000000-0000-4000-8000-000000000000"
current_device_id = "00000000-0000-4000-8000-000000000000"
# A mounted network drive or UNC path. The local SQLite database never belongs here.
nas_root_path = "Z:/IntraFlow"
# Workstation-only automatic Pull preferences. Push is always manual.
auto_pull_enabled = false
auto_pull_interval_minutes = 5
# Empty means the current Windows time zone. Use an IANA ID for an explicit zone.
display_timezone = "Asia/Seoul"
